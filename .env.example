# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed — this repo is public.

# Port exposed on the host by docker-compose (container always listens on 7272 internally)
HOST_PORT=7272

# Required. Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-random-64-character-hex-string

# Optional. Set to true to turn on the API (/api/v1) and the API Docs page.
# Leave it false until you want scripts or other systems to add entries.
# Admins then create keys under Admin -> API keys.
API_ENABLED=false

# Optional. Needed before an admin can turn on two-step sign-in (Admin -> Security).
# Encrypts each person's authenticator secret. At least 32 characters; generate with:
#   openssl rand -hex 32
# KEEP A COPY somewhere safe. If it is lost or changed, the stored secrets can't be
# read; an admin then uses "Reset everyone" and everyone sets up again.
MFA_ENCRYPTION_KEY=

# Emergency only. Set to true to ignore two-step sign-in entirely (for example if
# every admin is locked out), restart, sign in with passwords, fix things, then
# remove it and restart again.
MFA_FORCE_OFF=false
